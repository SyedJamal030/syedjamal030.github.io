---
import Icon from "../Icon.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Cards above the fold can skip lazy loading. */
  eager?: boolean;
  class?: string;
}

const { project, eager = false, class: className } = Astro.props;
const { title, excerpt, year, category, image } = project.data;
---

<a
  class:list={["work-card", className]}
  href={`/work/${project.id.replace(/^\d+-/, "")}/`}
  data-category={category}
>
  <div class="work-media">
    <span class="work-year">{year}</span>
    {
      image ? (
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
        />
      ) : null
    }
  </div>
  <div class="work-body">
    <div>
      <h3>{title}</h3>
      <span>{excerpt}</span>
    </div>
    <span class="work-go"><Icon name="arrow" class="ic-sm" /></span>
  </div>
</a>
