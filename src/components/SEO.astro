---
import { getEntry } from "astro:content";
const settingsData = await getEntry("settings", "main");
const { data: settings } = settingsData ?? {};

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = settings?.siteName ?? "Syed Jamal | Senior Frontend Architect",
  description = settings?.description ??
    "Senior Frontend Engineer specializing in React, Next.js, and low-debt architecture.",
  image = settings?.seo?.ogImage ?? "/og-default.png",
  imageAlt = "Syed Jamal - Senior Frontend Architect portfolio preview",
} = Astro.props;

const siteUrl = Astro.site ?? "http://localhost:4321";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const currentURL = Astro.url.href;

// Convert relative image path to absolute URL for scrapers
const imageURL = new URL(image, Astro.url.origin).href;
const siteName = "Syed Jamal";
---

<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, viewport-fit=cover"
/>
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{
  settings?.seo?.keywords && (
    <meta name="keywords" content={settings.seo.keywords.join(", ")} />
  )
}
<meta name="author" content="Syed Muhammad Jamal Waheed" />
<meta name="robots" content="index, follow" />
{settings?.oneLiner && <meta name="headline" content={settings.oneLiner} />}

<!-- Web App Manifest -->
<link rel="manifest" href="/site.webmanifest" />

<!-- Favicons & App Icons -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content={siteName} />

<!-- Theme Color for Mobile Browser Address Bar -->
<meta
  name="theme-color"
  media="(prefers-color-scheme: light)"
  content="#ffffff"
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: dark)"
  content="#0f172a"
/>

<!-- Open Graph / WhatsApp -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={currentURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:secure_url" content={imageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />

<meta name="twitter:url" content={currentURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Structured Data (JSON-LD) -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description: description,
    url: currentURL,
  })}
/>
