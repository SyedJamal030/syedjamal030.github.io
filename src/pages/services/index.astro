---
import PageLayout from "~/layouts/PageLayout.astro";
import ServiceCard from "~/components/cards/ServiceCard.astro";
import Process from "~/components/home/Process.astro";
import Faq from "~/components/home/Faq.astro";
import Cta from "~/components/home/Cta.astro";
import siteConfig from "~/config/site";
import { servicesHeading } from "~/data/highlights";
import { getCollection } from "astro:content";
import { isVisible } from "~/lib/utils";
import { graph, breadcrumbSchema, personSchema } from "~/lib/jsonld";

const services = (await getCollection("services"))
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order);

const pageTitle = "Services";
const pageEyebrow = servicesHeading.eyebrow;
const headingText = servicesHeading.title;
const introText =
  "Direct engineering, custom software solutions, and cross-functional project delivery. From frontend architecture to full-stack implementation and specialized team orchestration.";
const metaDescription = `Engineering services offered by ${siteConfig.author}. Web development, custom business systems, visual design, and product delivery.`;

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: "Home", url: `${siteConfig.url}/` },
    { name: "Services", url: `${siteConfig.url}/services/` },
  ]),
]);
---

<PageLayout
  title={pageTitle}
  heading={headingText}
  eyebrow={pageEyebrow}
  intro={introText}
  description={metaDescription}
  crumbs={[{ label: pageTitle }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="svc-list-h">
    <h2 class="sr-only" id="svc-list-h">All Services</h2>
    <div class="svc">
      {
        services.map((service, i) => (
          <ServiceCard
            service={service}
            headingLevel="h3"
            class:list={["rev", i % 3 > 0 && `rev-d${i % 3}`]}
          />
        ))
      }
    </div>
  </section>
  <Process />
  <Faq />
  <Cta />
</PageLayout>
