---
import PageLayout from '~/layouts/PageLayout.astro';
import About from '~/components/home/About.astro';
import Toolkit from '~/components/home/Toolkit.astro';
import Process from '~/components/home/Process.astro';
import Testimonials from '~/components/home/Testimonials.astro';
import StatsBand from '~/components/home/StatsBand.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const headingText = `${siteConfig.yearsOfExp}, and the same lesson keeps turning up.`;
const introText = `${siteConfig.author} is a ${siteConfig.role.toLowerCase()}. Building maintainable web applications, scalable frontend architectures, and reliable full-stack integrations.`;
const metaDescription = `About ${siteConfig.author} — a ${siteConfig.role.toLowerCase()} specializing in React, Next.js, and TypeScript.`;

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'About', url: `${siteConfig.url}/about/` },
  ]),
]);
---

<PageLayout
  title="About"
  heading={headingText}
  eyebrow="About"
  intro={introText}
  description={metaDescription}
  crumbs={[{ label: 'About' }]}
  jsonLd={jsonLd}
>
  <About headingLevel="h2" id="background" />
  <StatsBand />
  <Toolkit />
  <Process />
  <Testimonials />
  <Cta />
</PageLayout>
