---
import PageLayout from "~/layouts/PageLayout.astro";
import ContactForm from "~/components/ContactForm.astro";
import Icon from "~/components/Icon.astro";
import Faq from "~/components/home/Faq.astro";
import siteConfig from "~/config/site";
import { graph, personSchema, breadcrumbSchema } from "~/lib/jsonld";

const pageTitle = "Contact";
const headingText = "Tell me what deserves doing properly.";
const eyebrowText = "Contact";
const introText =
  "What is broken, who it is breaking for, and what happens if it stays that way. That is enough to come back with a scope and a number.";
const metaDescription = `Get in touch with ${siteConfig.author} for web engineering, custom business systems, visual design, or technical ghostwriting.`;

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: "Home", url: `${siteConfig.url}/` },
    { name: "Contact", url: `${siteConfig.url}/contact/` },
  ]),
]);
---

<PageLayout
  title={pageTitle}
  heading={headingText}
  eyebrow={eyebrowText}
  intro={introText}
  description={metaDescription}
  crumbs={[{ label: pageTitle }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="form-h">
    <div class="contact-grid">
      <div class="rev">
        <h2 class="d3" id="form-h" style="margin-bottom:24px">
          Send the brief
        </h2>
        <ContactForm />
      </div>

      <div class="contact-aside rev rev-d1">
        <a class="contact-card" href={`mailto:${siteConfig.contact.email}`}>
          <i><Icon name="mail" /></i>
          <div>
            <b>Email</b>
            <span>{siteConfig.contact.email}</span>
          </div>
        </a>

        <a class="contact-card" href={`tel:${siteConfig.contact.phoneHref}`}>
          <i><Icon name="phone" /></i>
          <div>
            <b>Phone</b>
            <span>{siteConfig.contact.phone}</span>
          </div>
        </a>

        <div class="contact-card">
          <i><Icon name="pin" /></i>
          <div>
            <b>Where</b>
            <span>{siteConfig.contact.location}</span>
          </div>
        </div>

        <div class="contact-card">
          <i><Icon name="spark" /></i>
          <div>
            <b>Availability</b>
            <span>{siteConfig.contact.availability}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq />
</PageLayout>
