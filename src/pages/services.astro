---
import GetInTouch from "../components/GetInTouch.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";

// Pull centralized project settings (site name, emails, socials)
const settingsData = await getEntry("settings", "main");
const { data: settings } = settingsData ?? {};

// Query services collection and sort strictly by the 'order' key
const servicesEntries = await getCollection("services");
const sortedServices = servicesEntries.sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title={`Services | ${settings?.siteName || "Portfolio"}`}>
  <main class="container py-32 px-6 mx-auto min-h-screen max-w-6xl relative">
    <div
      class="absolute top-20 left-10 w-72 h-72 bg-primary/5 rounded-full blur-3xl -z-10 pointer-events-none"
    >
    </div>
    <div
      class="absolute bottom-40 right-10 w-96 h-96 bg-secondary/5 rounded-full blur-3xl -z-10 pointer-events-none"
    >
    </div>

    <header class="max-w-3xl mb-20 text-center sm:text-left">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 mb-4"
      >
        <span
          class="text-[10px] font-bold uppercase tracking-widest text-primary"
          >Offerings</span
        >
      </div>
      <h1
        class="text-4xl sm:text-6xl font-bold tracking-tight text-foreground mb-6"
      >
        Professional <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-secondary to-primary bg-[length:200%_auto] animate-gradient"
          >Services</span
        >
      </h1>
      <p class="text-muted-foreground text-lg sm:text-xl leading-relaxed">
        Let's work together to engineer fast, striking, and structurally sound
        digital products that perform optimally.
      </p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-24">
      {
        sortedServices.map((service) => {
          const { title, description, icon, deliverables } = service.data;
          return (
            <div class="group relative overflow-hidden rounded-2xl border border-border bg-card/40 p-8 transition-all duration-300 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5 flex flex-col justify-between">
              <div>
                <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-2xl border border-primary/10 group-hover:scale-110 transition-transform duration-300">
                  {icon}
                </div>

                <h2 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors duration-300">
                  {title}
                </h2>

                <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
                  {description}
                </p>
              </div>

              {deliverables && (
                <ul class="mt-6 space-y-2.5 border-t border-border/60 pt-5">
                  {deliverables.map((item) => (
                    <li class="flex items-start gap-2.5 text-xs text-muted-foreground leading-relaxed">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-secondary" />
                      {item}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          );
        })
      }
    </section>

    <GetInTouch
      title="Ready to Start Your Next Project?"
      subtitle="Whether you need a custom build, technical consulting, or creative assistance, get in touch to get things off the ground."
      link="mailto:syed.jamal.waheed@gmail.com?subject=Business Software Consultation"
    />
  </main>
</Layout>

<style>
  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
  .animate-gradient {
    animation: gradient 6s ease infinite;
  }
</style>
